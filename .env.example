# Copy to .env and adjust. Every setting is optional; defaults live in shared/settings.py.

# extractive (offline baseline, no LLM) | ollama | gemini
LLM_PROVIDER=extractive
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and adds ~2 s per request
OLLAMA_URL=http://127.0.0.1:11434
# only used by the optional Docker Ollama (make ollama-up)
OLLAMA_PORT=11434
# Gemma 4 (e4b = Ollama's default gemma4 tag; use gemma4:e2b to fit fully in 6 GB VRAM)
OLLAMA_MODEL=gemma4:e4b
# keep models loaded this long after the last request (Ollama's default is 5m).
# Demo day: -1m = never unload, so the GPU never cold-starts on stage (no keep-warm ping needed).
OLLAMA_KEEP_ALIVE=30m
# load models when the API / UI / eval starts so the first question isn't a cold start
WARM_UP=true
# true = let Gemma 4 reason before answering (slower, ~6x the tokens)
OLLAMA_THINK=false
# Google AI Studio key (aistudio.google.com). Gemini 4 Hydrogen is Google's pick for new
# projects and has a free tier; gemini-3.5-flash-lite is the cheaper free-tier fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# minimal | low | medium | high | xhigh (empty = model default; use empty for Gemini 2.5)
GEMINI_THINKING_LEVEL=low
# seconds before a hung Gemini call gives up and the fallback chain takes over
GEMINI_TIMEOUT_S=30

# Fallback chain: tried in order when LLM_PROVIDER errors, times out, is rate-limited or
# returns invalid JSON. extractive never fails, so keep it last.
LLM_FALLBACK=ollama,extractive
# skip a provider for this many seconds after it fails (0 = always retry)
LLM_COOLDOWN_S=60

# hash (offline fallback) | ollama
EMBED_PROVIDER=hash
# EmbeddingGemma 2, text-only 570m tag (the default 740m tag adds image input)
EMBED_MODEL=embeddinggemma-2:570m
MEMORY_PATH=data/memory.sqlite
TOP_K=5
# findings below this confidence are rejected by grounding
MIN_CONFIDENCE=0.5

# --- SentinelDesk team settings ------------------------------------------------
# Dev default: EMBED_PROVIDER=hash (offline, fast). The demo index uses gemini (owner C builds it once).
# EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_BATCH=64
VALIDATION_FRACTION=0.10
QUEUE_CONCURRENCY=4
TICKET_STORE_PATH=data/tickets.sqlite
CORRECTIONS_PATH=data/sentinel/corrections.jsonl
