{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "uvicorn", "api.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "console",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "streamlit", "run", "ui/sentinel_console.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
